{
  "name": "@offermesh/backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "prebuild": "npm run generate:types",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run generate:types",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.1.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "20.19.11",
    "@types/sql.js": "1.4.9",
    "@types/supertest": "6.0.3",
    "json-schema-to-typescript": "15.0.4",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
