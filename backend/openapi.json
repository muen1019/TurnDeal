{
  "openapi": "3.1.0",
  "info": {
    "title": "OfferMesh Result API",
    "version": "0.3.0",
    "description": "Deterministic mock offers, durable accept/reject and recoverable Buyer Agent handoff. Fixed local demo buyer. No model rewriting or redemption."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001",
      "description": "本機 backend（npm run dev）"
    }
  ],
  "tags": [
    {
      "name": "Requests"
    },
    {
      "name": "Decisions"
    }
  ],
  "security": [],
  "paths": {
    "/api/requests": {
      "post": {
        "operationId": "createRequest",
        "tags": [
          "Requests"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted formatting snapshot; mock generation runs independently of GET.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSnapshot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/requests/{request_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RequestId"
        }
      ],
      "get": {
        "operationId": "getRequestResult",
        "tags": [
          "Requests"
        ],
        "responses": {
          "200": {
            "description": "Stable snapshot including persisted decision or null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSnapshot"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/requests/{request_id}/decisions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RequestId"
        }
      ],
      "post": {
        "operationId": "submitDecision",
        "tags": [
          "Decisions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AcceptDecision"
                  },
                  {
                    "$ref": "#/components/schemas/RejectDecision"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved accepted or rejected decision; no document rewrite or child creation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "410": {
            "description": "offer_expired：伺服器時間 >= expires_at；不改價、不換方案",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
