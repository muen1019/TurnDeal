---
import Layout from '../layouts/Layout.astro';
import { copy } from '../content/copy';
import { milestones } from '../content/story';
import { team } from '../content/team';
import { base, contact, portfolio, route, video, type Lang } from '../content/links';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const demo = route(lang, 'how-it-works/') + '#demo';
const award = milestones[0];
const websiteLabel = lang === 'zh' ? '個人網站' : 'Personal website';
---
<Layout lang={lang} page="story/">
  <section class="soft section">
    <div class="wrap split story-hero">
      <div><p class="eyebrow">{t.nav[1]}</p><h1>{t.story[0]}</h1><p class="lead">{t.story[1]}</p></div>
      <img src={base + 'photos/' + award.photos[0]} alt={award[lang].images[0]} fetchpriority="high" width="1500" height="1000" />
    </div>
  </section>
  <section class="wrap section" id="journey">
    <h2>{t.story[2]}</h2>
    <div class="timeline">
      {milestones.filter(event => event.published).map(event => (
        <article id={event.id}>
          <time datetime={event.date}>{event[lang].date}</time>
          <h3>{event[lang].title}</h3>
          <p>{event[lang].description}</p>
          <a class="text-link" href={portfolio}>{lang === 'en' ? 'Read the project write-up' : '閱讀專案紀錄'} ↗</a>
          <div><a class="text-link" href="https://ec.ltn.com.tw/article/paper/1770621">{lang === 'en' ? 'Press coverage · Liberty Times' : '媒體報導 · 自由財經'} ↗</a></div>
          <h4>{t.story[3]}</h4>
          <div class="gallery">
            {event.photos.map((photo, index) => <figure><img src={base + 'photos/' + photo} loading="lazy" alt={event[lang].images[index]} /><figcaption>{event[lang].images[index]}</figcaption></figure>)}
          </div>
          <a class="button secondary" href={video}>▶ <span>{t.story[4]}</span> ↗</a>
        </article>
      ))}
    </div>
  </section>
  <section class="soft section">
    <div class="wrap">
      <h2>{t.story[5]}</h2><p class="lead">{t.story[6]}</p>
      <div class="card-grid team-grid">
        {team.map(member => <article class="card">
          <span class="feature-icon" aria-hidden="true">{lang === 'zh' ? member.name.zh[0] : member.initials}</span>
          <h3>{member.name[lang]}</h3><p class="team-role">{member[lang][0]}</p><p>{member[lang][1]}</p>
          <div class="team-links">
            <a href={member.linkedin} aria-label={member.name[lang] + ' · LinkedIn'} title="LinkedIn">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.67 2 3.5v17c0 .83.69 1.5 1.55 1.5h16.9c.86 0 1.55-.67 1.55-1.5v-17c0-.83-.69-1.5-1.55-1.5ZM8 19H5V9.5h3V19ZM6.5 8.2a1.73 1.73 0 1 1 0-3.46 1.73 1.73 0 0 1 0 3.46ZM19 19h-3v-4.63c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46V19h-3V9.5h2.88v1.3h.04a3.16 3.16 0 0 1 2.84-1.56C18.45 9.24 19 11.2 19 13.75V19Z"/></svg>
            </a>
            <a href={member.github} aria-label={member.name[lang] + ' · GitHub'} title="GitHub">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
            </a>
            {member.website && <a href={member.website} aria-label={member.name[lang] + ' · ' + websiteLabel} title={websiteLabel}>
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>
              </svg>
            </a>}
          </div>
        </article>)}
      </div>
      <a class="text-link" href={contact}>{t.contact} ↗</a>
    </div>
  </section>
  <section class="ink section"><div class="wrap callout"><h2>{t.story[7]}</h2><p class="lead">{t.story[8]}</p><div class="actions"><a class="button mint" href={demo}>{t.demo} ↗</a><a class="button outline" href={route(lang)}>{t.story[9]}</a></div></div></section>
</Layout>
