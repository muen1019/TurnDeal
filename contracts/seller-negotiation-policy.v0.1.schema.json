{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic private Seller negotiation policies v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "data_origin",
    "sellers"
  ],
  "properties": {
    "schema_version": {
      "const": "seller-policy-v0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "data_origin": {
      "const": "synthetic"
    },
    "sellers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seller_id",
          "status",
          "settings",
          "listings"
        ],
        "properties": {
          "seller_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "ready"
            ]
          },
          "settings": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "strategy",
              "max_rounds",
              "timeout_ms",
              "quote_ttl_seconds",
              "buyer_below_floor",
              "after_last_round"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "price_first",
                  "delivery_first",
                  "bundle_first",
                  "balanced"
                ]
              },
              "max_rounds": {
                "const": 2
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3000
              },
              "quote_ttl_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "buyer_below_floor": {
                "enum": [
                  "counter_at_floor",
                  "refuse"
                ]
              },
              "after_last_round": {
                "const": "stop"
              }
            }
          },
          "listings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "listing_id",
                "terms"
              ],
              "properties": {
                "listing_id": {
                  "type": "string",
                  "minLength": 1
                },
                "terms": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "floor_item_price_twd",
                    "round_discount_twd",
                    "shipping",
                    "delivery",
                    "addon"
                  ],
                  "properties": {
                    "floor_item_price_twd": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "round_discount_twd": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "shipping": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "waive_from_round",
                        "min_item_subtotal_twd"
                      ],
                      "properties": {
                        "waive_from_round": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1,
                          "maximum": 2
                        },
                        "min_item_subtotal_twd": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "delivery": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "fastest_days",
                        "expedite_from_round",
                        "expedite_fee_twd"
                      ],
                      "properties": {
                        "fastest_days": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "expedite_from_round": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1,
                          "maximum": 2
                        },
                        "expedite_fee_twd": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "addon": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "required": [
                        "listing_id",
                        "mode",
                        "buyer_price_twd",
                        "from_round",
                        "min_item_subtotal_twd"
                      ],
                      "properties": {
                        "listing_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "mode": {
                          "enum": [
                            "free_gift",
                            "paid_optional"
                          ]
                        },
                        "buyer_price_twd": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "from_round": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2
                        },
                        "min_item_subtotal_twd": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
