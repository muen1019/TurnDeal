    "SellerNegotiationResult": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "seller_id": {
          "$ref": "#/$defs/Id"
        },
        "round": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "offered",
            "refused",
            "timeout",
            "error"
          ]
        },
        "drafts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SellerOfferDraft"
          },
          "maxItems": 2
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
