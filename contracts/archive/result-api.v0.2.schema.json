        "request_id",
        "seller_id",
        "round",
        "outcome",
        "drafts",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "offered"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "drafts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "drafts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
