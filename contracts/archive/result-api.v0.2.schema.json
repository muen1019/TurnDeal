        },
        "status": {
          "const": "rejected"
        },
        "feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "source_documents": {
          "$ref": "#/$defs/DocumentBundle"
        }
      },
      "required": [
        "action",
        "request_id",
        "status",
        "feedback",
        "source_documents"
      ],
      "additionalProperties": false
    },
    "DecisionResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/AcceptDecisionResult"
        },
        {
          "$ref": "#/$defs/RejectDecisionResult"
        }
      ]
    },
    "RedemptionReceipt": {
      "type": "object",
      "properties": {
        "redemption_id": {
          "$ref": "#/$defs/Id"
        },
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "offer_id": {
          "$ref": "#/$defs/Id"
        },
        "seller_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "const": "redeemed"
        },
        "mode": {
          "const": "virtual_market"
        },
        "total_price_twd": {
          "$ref": "#/$defs/MoneyTwd"
        },
        "redeemed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "redemption_id",
        "request_id",
        "offer_id",
        "seller_id",
        "status",
        "mode",
        "total_price_twd",
        "redeemed_at"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
