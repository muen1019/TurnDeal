{
  "name": "offermesh-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "npm --prefix ../backend run build && npm run build && cd .. && node scripts/test-improver-ui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prebuild": "npm run generate:types",
    "pretest": "npm run generate:types",
    "test:api:e2e": "npm --prefix ../backend run build && node --test ../tests/runtime.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.468.0",
    "motion": "12.23.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.17.19",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.0.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
