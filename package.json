{
  "name": "offermesh",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/mobile-preview.mjs",
    "dev:secure": "powershell -NoProfile -File scripts/run-app-secure.ps1",
    "test:runtime": "node --test tests/runtime.test.mjs tests/buyer-profile.test.mjs tests/refinement.test.mjs",
    "test": "npm run test:contracts && npm run test:db && npm run test:orchestrator && npm run test:seller-policies && npm run test:unit && npm run test:negotiation && npm run test:evaluator && npm run test:formatter && npm run test:runtime",
    "test:formatter": "node --test tests/formatter.test.ts tests/formatter-llm.test.ts tests/document-semantics.test.ts tests/clarification.test.ts",
    "demo:formatter:llm": "node examples/formatter-llm.ts",
    "demo:formatter:secure": "powershell -NoProfile -File scripts/run-formatter-secure.ps1",
    "demo:formatter": "node examples/formatter.ts",
    "test:seller-policies": "node scripts/validate-seller-policies.mjs && node --test tests/seller-policies.test.mjs",
    "test:orchestrator": "node --test tests/orchestrator-data.test.ts tests/discovery.test.ts tests/handoff.test.ts",
    "demo:handoff": "node examples/handoff.ts",
    "db:seed:discovery": "node scripts/discovery-db.mjs",
    "demo:discovery": "node examples/discovery.ts",
    "demo:orchestrator": "node examples/orchestrator-input.ts",
    "test:contracts": "node scripts/validate-contracts.mjs && node scripts/validate-result-contracts.mjs",
    "test:db": "node scripts/db.mjs --memory",
    "db:init": "node scripts/db.mjs",
    "db:migrate": "node scripts/db.mjs --migrate",
    "db:rebuild": "node scripts/db.mjs --force",
    "db:check": "node scripts/db.mjs --check",
    "test:evaluator": "node --test tests/evaluator.test.mjs",
    "test:negotiation": "node --test tests/negotiation.test.mjs",
    "test:unit": "node --test tests/agents.unit.test.mjs tests/validation.unit.test.mjs tests/model.unit.test.mjs",
    "test:e2e": "node scripts/e2e-negotiation.mjs --offline",
    "test:e2e:live": "node scripts/e2e-negotiation.mjs --live",
    "test:e2e:full": "node scripts/e2e-negotiation.mjs --offline --evaluate",
    "test:e2e:full:live": "node scripts/e2e-negotiation.mjs --live --evaluate",
    "demo:negotiate": "node scripts/negotiate.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
